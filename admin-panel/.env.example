ADMIN_PORT=3001
MONGO_URI=mongodb://chat-mongodb:27017/LibreChat
ADMIN_USERNAME=admin@example.com
# Generate with: node -e "require('bcryptjs').hash(process.argv[1], 12).then(console.log)" 'your-password'
ADMIN_PASSWORD_HASH='$2b$12$replace_with_a_bcrypt_hash'
# Generate with: openssl rand -hex 48
ADMIN_SESSION_SECRET=replace_with_at_least_64_random_characters
COOKIE_SECURE=true
ADMIN_IMAGES_ROOT=/data/images
ADMIN_UPLOADS_ROOT=/data/uploads
ADMIN_DELETE_IMAGES_ROOT=/data/cleanup-images
ADMIN_DELETE_UPLOADS_ROOT=/data/cleanup-uploads
ADMIN_BACKUP_ROOT=/data/backups
NODE_ENV=production
